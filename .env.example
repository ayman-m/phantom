# ═══════════════════════════════════════════════════════════════════
#  Phantom stack — local .env (copy to .env, fill in, gitignored).
#
#  Three credential categories, three different stores:
#
#    ┌─────────────────────┬──────────────────────────┬───────────────────┐
#    │ Category            │ Source of truth          │ Examples          │
#    ├─────────────────────┼──────────────────────────┼───────────────────┤
#    │ Local-service       │ GitHub Secrets → CI →    │ CALDERA_API_KEY,  │
#    │ bake-in             │ docker-compose env       │ CALDERA_RED_PASS  │
#    │ (no runtime API)    │                          │                   │
#    ├─────────────────────┼──────────────────────────┼───────────────────┤
#    │ Compose-time        │ GitHub Variables → CI →  │ ANIMATED,         │
#    │ tunables            │ build-args / compose env │ CALDERA_VARIANT   │
#    ├─────────────────────┼──────────────────────────┼───────────────────┤
#    │ Operator runtime    │ SETUP PAGE → SecretStore │ UI_USER/PASSWORD, │
#    │ config              │ instances.db             │ MCP_TOKEN,        │
#    │                     │                          │ GEMINI_API_KEY,   │
#    │                     │                          │ XSIAM creds, etc. │
#    └─────────────────────┴──────────────────────────┴───────────────────┘
#
#  This file is for LOCAL DEV ONLY — it sets convenience defaults so
#  `docker compose up` works without going through setup. In CI deploys,
#  only the local-service-bake-in + compose-tunable sections come from
#  GitHub; everything else gets typed into the setup form at first run.
#
#  Section markers below (CI-MANAGED / SETUP-MANAGED) are the contract.
# ═══════════════════════════════════════════════════════════════════


# ═══════════════════════════════════════════════════════════════════
#  CI-MANAGED — local-service bake-in + compose tunables.
#
#  These are the only values GitHub Actions sets. Caldera writes
#  CALDERA_API_KEY / CALDERA_RED_PASSWORD into conf/local.yml in its
#  entrypoint script — no runtime API to override.
# ═══════════════════════════════════════════════════════════════════

# Caldera bake-in (Secrets in CI)
CALDERA_API_KEY=your_caldera_api_key
CALDERA_RED_PASSWORD=change_me

# Caldera tunables (Variables in CI)
CALDERA_RED_USER=red
CALDERA_VARIANT=full

# Optional TLS — Caldera runs HTTP without these.
# One-line PEM with \n escapes (see README for openssl + awk recipe).
SSL_CERT_PEM=
SSL_KEY_PEM=


# ═══════════════════════════════════════════════════════════════════
#  COMPOSE-INTERNAL — constants, never operator-supplied.
#
#  Hostnames inside the docker network. Don't change these unless
#  you also change docker-compose.yml's service names.
# ═══════════════════════════════════════════════════════════════════

XLOG_URL=http://xlog:8000
XLOG_PORT=8000
# Bearer token xlog's auth middleware enforces, and the value the xlog
# connector instance's "API Token" secret must be set to.
#
# REQUIRED for dev compose. Customer installs never hit this: the installer
# generates the key on a fresh install and refuses to upgrade without it. Only
# a hand-rolled `docker compose up` from this repo can end up with it unset,
# and xlog will then serve /health but refuse everything else rather than
# running unauthenticated.
#
# Generate one with:  openssl rand -hex 32
XLOG_API_KEY=
MCP_URL=http://phantom-mcp:8080/api/v1/stream/mcp
CALDERA_URL=http://caldera:8888

# MCP transport (defaults are usually fine).
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8080
MCP_PATH=/api/v1/stream/mcp

# System-invariant bearer for /api/v1/* admin endpoints. Must agree
# between phantom-mcp and phantom-agent. In production this gets
# generated on first setup and lives in the SecretStore; in local
# dev set whatever you want here.
MCP_TOKEN=your_mcp_bearer_token


# ═══════════════════════════════════════════════════════════════════
#  SETUP-MANAGED — operator types these into the setup page at
#  first run. Listed here ONLY for local-dev convenience; in real
#  deploys these are commented out and supplied via the form.
#
#  Setting them here pre-populates the auto-migration path
#  (connector_loader._auto_migrate) so the dev loop works without
#  going through the setup form. Leave commented in CI.
# ═══════════════════════════════════════════════════════════════════

# ─── Operator login ─────────────────────────────────
# UI_USER=phantom
# UI_PASSWORD=strong_password

# ─── Model providers ────────────────────────────────
# Use either GEMINI_API_KEY OR GOOGLE_APPLICATION_CREDENTIALS, not both.
# GEMINI_API_KEY=your_gemini_api_key
# GOOGLE_APPLICATION_CREDENTIALS=content_of_service_account.json
# GEMINI_MODEL=gemini-3-pro-preview

# ─── XSIAM tenant (external) ────────────────────────
# CORTEX_MCP_PAPI_URL=https://api-your-tenant.xdr.region.paloaltonetworks.com
# CORTEX_MCP_PAPI_AUTH_HEADER=your_papi_auth_header
# CORTEX_MCP_PAPI_AUTH_ID=your_papi_auth_id
# PLAYGROUND_ID=156086

# ─── XSIAM webhook (external) ───────────────────────
# WEBHOOK_ENDPOINT=https://api-your-tenant.xdr.region.paloaltonetworks.com/logs/v1/event
# WEBHOOK_KEY=your_webhook_key

# ─── xlog operational tunables (bundle settings) ────
# WORKERS_NUMBER=25
#
# Generation-rate ceilings. A worker's rate is count/interval events per
# second and it runs until stopped, so these bound how much synthetic
# telemetry the stack can emit. Set any to 0 to disable that ceiling.
# Sustained rate allowed per worker:
# XLOG_MAX_WORKER_EVENTS_PER_SEC=10
# A worker declaring duration_seconds or max_events is a bounded BURST and
# may run much faster, up to a fixed total:
# XLOG_MAX_BURST_EVENTS_PER_SEC=500
# XLOG_MAX_BURST_EVENTS=50000
# XLOG_MAX_CONCURRENT_BURSTS=1
# Combined sustained rate across every live worker:
# XLOG_MAX_TOTAL_EVENTS_PER_SEC=50
# Optional per-worker budgets, OFF by default so generation is continuous:
# XLOG_WORKER_MAX_EVENTS=0
# XLOG_WORKER_MAX_LIFETIME_SECONDS=0
# Reaper: reclaims capacity from workers that stopped making progress without
# exiting (blocked socket send, dead thread). Dead-thread detection is
# unambiguous and always on. Stall detection is heuristic and OFF by default —
# a 0.2 ev/s baseline worker emits once every 5s BY DESIGN, and reaping a
# healthy worker is worse than the capacity leak. Set a floor in seconds to
# enable it; the effective threshold is max(floor, 20 x the worker's interval).
# XLOG_REAPER_INTERVAL_SECONDS=60
# XLOG_REAPER_STALL_SECONDS=0
# LOGGING_DIR=logs
# LOGGING_STORAGE_SIZE=10M
# LOGGING_TRUNCATE_LIMIT=100
# XSIAM_MANDATORY_PARSED_FIELDS=remote_ip,remote_port,local_ip,local_port,event_timestamp,severity,alert_name
# XSIAM_OPTIONAL_PARSED_FIELDS=alert_description,action_status,local_ip_v6,remote_ip_v6

# ─── Technology Stack (bundle setting, JSON) ────────
# Defines the org's security stack and default log destination.
# TECHNOLOGY_STACK={"stack_name":"Enterprise Security Stack","log_destination":{"type":"syslog","protocol":"udp","host":"10.0.0.8","port":514,"full_address":"udp:10.0.0.8:514"},"vendors":[{"vendor":"Fortinet","product":"FortiGate","category":"Firewall","formats":["CEF","SYSLOG","JSON"]}]}


# ═══════════════════════════════════════════════════════════════════
#  OPTIONAL — feature flags + spark-platform supersession.
# ═══════════════════════════════════════════════════════════════════

# Force Examples RAG DB rebuild on phantom-mcp boot (xsiam connector).
REBUILD_XQL_CHROMA=true

# Force re-sync of the bundled skills on phantom-mcp boot.
FORCE_SKILLS_SYNC=1

# v1.2 stage 3E — when set, the embedded MCP yields connector tool
# advertisement to the platform's central connector-manager. Leave
# unset for standalone mode.
# SPARK_PLATFORM_GATEWAY=https://gateway.your-spark.example
